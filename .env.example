# Supabase — all DB/storage access happens server-side with the service
# role key; it must never reach the browser. The publishable key below is
# safe to expose (public by design, RLS-protected) but is currently unused
# since the app has no client-side Supabase calls.
NEXT_PUBLIC_SUPABASE_URL=https://fgjsmmnlftoixannpiiy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_f0CrqxCqumZItOcExz0CYQ_ANiOtV5U

# Anthropic (server-side only)
ANTHROPIC_API_KEY=

# Model routing — swap models without touching code.
# Strong vision model: initial screenshot analysis, visual comparison.
CLAUDE_VISION_MODEL=claude-opus-4-1-20250805
# Cost-efficient model: follow-up questions, tag refinement, text-only work.
CLAUDE_TEXT_MODEL=claude-haiku-4-5-20251001

# Optional: enables semantic/vector search. Without it the app falls back to
# keyword search only — nothing else in the app degrades.
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5-lite

# Cost controls
MONTHLY_AI_BUDGET_USD=20
